# ======================================================================
# Mẫu cấu hình JadeCard. Sao chép file này thành ".env" rồi điền giá trị.
# KHÔNG đưa file .env lên GitHub (đã có trong .gitignore).
# ======================================================================

# Cổng chạy web (mặc định 5500 → http://localhost:5500)
PORT=5500

# Khóa bí mật để băm mã OTP: đặt một chuỗi ngẫu nhiên dài, ví dụ tạo bằng lệnh
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Gửi OTP qua Gmail. Để trống cả hai → chế độ lập trình: OTP in ra cửa sổ dòng lệnh
# và hiện ngay trên trang nhập mã (máy chưa cấu hình Gmail vẫn đăng ký được).
# SMTP_PASS là "Mật khẩu ứng dụng" (App Password) 16 ký tự, KHÔNG phải mật khẩu Gmail:
#   1. Bật Xác minh 2 bước: https://myaccount.google.com/signinoptions/twosv
#   2. Tạo mật khẩu ứng dụng: https://myaccount.google.com/apppasswords (đặt tên "JadeCard")
#   3. Dán 16 ký tự vào SMTP_PASS, rồi chạy  npm run mail:test  để gửi thư thử
# Gmail luôn hiện người gửi là SMTP_USER, nên MAIL_FROM nên dùng cùng địa chỉ đó.
SMTP_USER=
SMTP_PASS=
MAIL_FROM="JadeCard <ban@gmail.com>"

# Đặt 0 để npm start không tự mở trình duyệt
OPEN_BROWSER=1
